# Example environment variables for QuantVantageAI demo

# Your Anthropic API key used for report generation
ANTHROPIC_API_KEY=
# Required for encrypted-at-rest advertiser/subscription/report storage (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QV_DATA_ENCRYPTION_KEY=
# Optional: override the QuantVantage API URL
QUANTVANTAGE_API_URL=https://api.quantvantage.ai/v1/assistant
